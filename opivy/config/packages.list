# One package per line. Installed into the root filesystem by chroot-setup.sh.

# --- Layer 1: kernel and early boot ---
linux-image-generic
initramfs-tools
live-boot
live-boot-initramfs-tools
zstd

# --- Layer 2: core userland ---
systemd-sysv
systemd-timesyncd
dbus
udev
kmod
sudo
locales
console-setup
kbd
bash-completion
less
nano
vim-tiny
procps
psmisc
htop
man-db
file
ca-certificates
curl
wget
openssh-client
pciutils
usbutils

# --- Layer 2: networking ---
network-manager
# real hardware: Wi-Fi tools and rules, laptop sound firmware, processor fixes, battery
iw
wireless-regdb
firmware-sof-signed
intel-microcode
amd64-microcode
upower
tzdata
iproute2
iputils-ping
wpasupplicant

# --- Layer 2: disks and installing to a drive ---
parted
dosfstools
e2fsprogs
rsync
grub-common
grub2-common
grub-pc-bin
grub-efi-amd64-bin
efibootmgr

# --- Layer 4: desktop ---
# window manager, menu bar and dock, launcher, notifications, lock screen
labwc
waybar
fuzzel
mako-notifier
libnotify-bin
swaybg
swaylock
swayidle
wlrctl
# presses shortcuts for the app menu (Zoom, Full Screen)
wtype
wlr-randr
grim
slurp
wl-clipboard
xwayland
brightnessctl
# graphics drivers, session plumbing
libgl1-mesa-dri
libegl1
libgles2
dbus-user-session
xdg-utils
xdg-user-dirs
libglib2.0-bin
gsettings-desktop-schemas
dconf-gsettings-backend
python3
# sound
pipewire
pipewire-pulse
wireplumber
# lets the sound server run at real-time priority, so audio does not crackle
rtkit
pavucontrol
# fonts and icons
fonts-roboto-unhinted
fonts-jetbrains-mono
fonts-dejavu-core
fontconfig
fonts-noto-color-emoji
adwaita-icon-theme
papirus-icon-theme
librsvg2-bin
librsvg2-common
# apps
foot
thunar
gvfs
mousepad
epiphany-browser
# viewers, so double-clicking a picture, PDF or film opens something
ristretto
evince
mpv
# Application Center and Control Center
python3-gi
python3-gi-cairo
gir1.2-gtk-3.0
# the live console: drawing on the desktop layer, and SVG
gir1.2-gtklayershell-0.1
# lets GTK 3 apps hand their menus to the menu bar
appmenu-gtk3-module
gir1.2-rsvg-2.0
wdisplays
bluez
blueman
rfkill
network-manager-applet
