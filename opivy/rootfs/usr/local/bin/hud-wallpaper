#!/usr/bin/env python3
"""hud-wallpaper - draw the desktop background from the active theme.

Reads ~/.config/hud/resolved.json (written by hudctl apply) and writes
wallpaper.svg and wallpaper.png next to it. The picture is a station
console: ruled panels, a name plate, an eight-sided status frame, a
numbered unit list, a sequence strip and checkerboard register marks.
Change "wallpaper_seed" for a different arrangement of the small print.
"""
import hashlib
import json
import os
import random
import subprocess
import sys

USER = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "hud")
W, H = 2560, 1600

with open(os.path.join(USER, "resolved.json")) as f:
    v = json.load(f)
if v.get("wallpaper", "generated") != "generated":
    sys.exit(0)

keys = ("bg bg_alt panel text muted line line_dim title warn alert ok cool cyan "
        "wallpaper_seed scanlines glow os_name font_ui font_mono border_width glow_strength").split()
stamp = hashlib.sha256(json.dumps([v.get(k) for k in keys] + [4]).encode()).hexdigest()
stamp_file = os.path.join(USER, "wallpaper.stamp")
png = os.path.join(USER, "wallpaper.png")
if os.path.exists(png) and os.path.exists(stamp_file) and open(stamp_file).read() == stamp:
    sys.exit(0)

SW = float(v.get("border_width", "2")) + 1
rnd = random.Random(int(v.get("wallpaper_seed", "14") or 14))
BG, LINE, DIM, TITLE, MUTED = v["bg"], v["line"], v["line_dim"], v["title"], v["muted"]
NAME = v.get("os_name", "HUD").upper()
out = []
add = out.append


def text(x, y, string, colour=LINE, size=26, anchor="start", spacing=2, family=None):
    family = family or v["font_ui"]
    add(f'<text x="{x:.0f}" y="{y:.0f}" fill="{colour}" font-family="{family}, sans-serif" '
        f'font-size="{size}" font-weight="bold" letter-spacing="{spacing}" '
        f'text-anchor="{anchor}">{string}</text>')


def box(x, y, w, h, colour=LINE, width=SW, fill="none"):
    add(f'<rect x="{x:.0f}" y="{y:.0f}" width="{w:.0f}" height="{h:.0f}" fill="{fill}" '
        f'stroke="{colour}" stroke-width="{width}"/>')


def plate(x, y, w, h, string, size=None, colour=LINE, anchor="start"):
    """A lit bar with dark lettering on it."""
    size = size or h * 0.62
    add(f'<rect x="{x:.0f}" y="{y:.0f}" width="{w:.0f}" height="{h:.0f}" fill="{colour}"/>')
    tx = {"start": x + h * 0.3, "middle": x + w / 2, "end": x + w - h * 0.3}[anchor]
    text(tx, y + h / 2 + size * 0.36, string, BG, size, anchor)


def checker(x, y, size, n=3, colour=LINE):
    """A checkerboard register mark, n cells a side."""
    c = size / n
    for i in range(n):
        for j in range(n):
            if (i + j) % 2 == 0:
                add(f'<rect x="{x + i * c:.1f}" y="{y + j * c:.1f}" width="{c:.1f}" height="{c:.1f}" '
                    f'fill="{colour}"/>')


def split(x, y, size, flip=False, colour=LINE):
    """A square marker, one half lit along the diagonal."""
    a, b = x + size, y + size
    tri = f"M{x} {y}H{a}L{x} {b}Z" if flip else f"M{a} {y}V{b}H{x}Z"
    add(f'<path d="{tri}" fill="{colour}"/>')
    box(x, y, size, size, colour, 2)


def octagon(x, y, w, h, c, colour=LINE, width=SW, fill="none"):
    add(f'<path d="M{x + c} {y}H{x + w - c}L{x + w} {y + c}V{y + h - c}L{x + w - c} {y + h}'
        f'H{x + c}L{x} {y + h - c}V{y + c}Z" fill="{fill}" stroke="{colour}" stroke-width="{width}"/>')


def mark(x, y, size, colour=LINE, ground=BG):
    """The system mark: a square plate with a chevron cut into it."""
    t = size * 0.12
    add(f'<rect x="{x}" y="{y}" width="{size}" height="{size}" fill="{colour}"/>')
    add(f'<rect x="{x + t:.1f}" y="{y + t:.1f}" width="{size - 2 * t:.1f}" height="{size - 2 * t:.1f}" '
        f'fill="{ground}"/>')
    a, b, m = x + size * 0.26, x + size * 0.74, x + size * 0.5
    add(f'<path d="M{a:.1f} {y + size * 0.28:.1f}L{m:.1f} {y + size * 0.72:.1f}L{b:.1f} {y + size * 0.28:.1f}" '
        f'fill="none" stroke="{colour}" stroke-width="{t:.1f}" stroke-linejoin="miter"/>')


def small_print(x, y, rows, cols, colour=MUTED, size=13, step=20):
    """Columns of tiny code groups, the filler text of a console."""
    for r in range(rows):
        row = "  ".join(f"{rnd.randint(0, 0xfff):03X}-{rnd.randint(10, 99)} {rnd.choice('ABDKNRSTU')}{rnd.choice('ABDKNRSTU')}"
                        for _ in range(cols))
        text(x, y + r * step, row, colour, size, spacing=1)


add(f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" viewBox="0 0 {W} {H}">')
blur = 1.2 + 1.3 * int(v.get("glow_strength", "1") or 0)
add(f'''<defs>
<radialGradient id="tube" cx="50%" cy="46%" r="75%">
 <stop offset="0" stop-color="{v["bg_alt"]}"/><stop offset="0.7" stop-color="{BG}"/>
</radialGradient>
<filter id="glow" x="-5%" y="-5%" width="110%" height="110%">
 <feGaussianBlur stdDeviation="{blur}" result="b"/>
 <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
</filter>
<pattern id="scan" width="4" height="4" patternUnits="userSpaceOnUse">
 <rect width="4" height="1.2" fill="{BG}"/>
</pattern>
</defs>''')
add(f'<rect width="{W}" height="{H}" fill="url(#tube)"/>')
add('<g filter="url(#glow)">' if v.get("glow") == "yes" else "<g>")

# Ruled panels. The top and bottom strips sit behind the menu bar and dock.
L, R, T, B = 70, W - 70, 130, H - 190
box(L, T, R - L, B - T)
SPLIT_X = 1560                   # left column | right column
MID_Y = 880                      # upper row | lower row
add(f'<path d="M{SPLIT_X} {T}V{B}M{L} {MID_Y}H{SPLIT_X}M{SPLIT_X} {MID_Y + 110}H{R}" '
    f'stroke="{LINE}" stroke-width="{SW}" fill="none"/>')
for x, y in ((L, T), (R, T), (L, B), (R, B)):
    checker(x - 21, y - 21, 42)

# --- upper left: name plate and the large mark ---
px, py = L + 70, T + 80
mark(px, py, 150)
plate(px + 180, py, 150 + len(NAME) * 104, 150, NAME, 104)
text(px + 184, py + 196, "STATION DESKTOP SYSTEM", LINE, 30, spacing=7)
text(px, py + 290, "A WORKING CONSOLE FOR ONE OPERATOR.  ALL UNITS REPORT TO THIS DESK.", MUTED, 17, spacing=2)
small_print(px, py + 330, 4, 6)
# Small markers down the left edge of the panel.
for i, yy in enumerate((py + 470, py + 540, py + 610)):
    split(px, yy, 46, flip=i % 2 == 1)
    text(px + 64, yy + 22, ("SYS NAV", "NET COM", "PWR BUS")[i], LINE, 17)
    text(px + 64, yy + 43, ("4401-6U4", "2207-1D9", "9030-3K2")[i], MUTED, 14)
checker(px + 300, py + 480, 90, 3)
# Bar meters.
for i in range(5):
    bx = px + 470 + i * 120
    box(bx, py + 470, 84, 186, LINE, 2)
    level = rnd.uniform(0.2, 0.95)
    add(f'<rect x="{bx + 10}" y="{py + 470 + 176 - 166 * level:.0f}" width="64" height="{166 * level:.0f}" '
        f'fill="{LINE}"/>')
    text(bx + 42, py + 686, ("AV", "COM", "NAV", "ENV", "AUX")[i], LINE, 17, "middle")

# --- upper right: eight-sided status frame ---
ox, oy, ow, oh = SPLIT_X + 90, T + 150, R - SPLIT_X - 180, 560
text(ox + 40, oy - 34, "DESK 14", LINE, 22)
text(ox + ow - 40, oy - 34, "00-TRAQ", LINE, 22, "end")
octagon(ox, oy, ow, oh, 110, LINE, SW + 3)
octagon(ox + 22, oy + 22, ow - 44, oh - 44, 98, LINE, 2)
plate(ox + 110, oy + 66, ow - 220, 90, "STANDING BY", 40, anchor="middle")
text(ox + ow / 2, oy + 200, "ALL UNITS ACCOUNTED FOR", LINE, 21, "middle", 4)
add(f'<path d="M{ox + 22} {oy + 236}H{ox + ow - 22}M{ox + 22} {oy + 404}H{ox + ow - 22}" '
    f'stroke="{LINE}" stroke-width="{SW}"/>')
text(ox + ow / 2, oy + 352, "NOMINAL", TITLE, 84, "middle", 6)
checker(ox + ow / 2 - 24, oy + 424, 48)
text(ox + ow / 2, oy + 508, "LINK ESTABLISHED", LINE, 21, "middle", 4)
split(ox - 62, oy + oh / 2 - 23, 46)
split(ox + ow + 16, oy + oh / 2 - 23, 46, flip=True)
text(ox + ow / 2, oy + oh + 60, "COM . NAV", LINE, 34, "middle", 6)

# --- lower left: numbered unit list ---
ly = MID_Y + 60
text(L + 70, ly, "OPERATIONAL NOTIFICATIONS", LINE, 24, spacing=5)
split(SPLIT_X - 116, ly - 34, 46)
units = (("CORE", "ONLINE - LOAD NOMINAL", LINE), ("STORE", "MOUNTED - 71.0% FREE", LINE),
         ("LINK", "X OFFLINE X - NO SIGNAL", v["alert"]), ("POWER", "BUS A - HOLDING", LINE))
for i, (unit, state, colour) in enumerate(units):
    yy = ly + 44 + i * 82
    text(L + 70, yy + 42, unit, colour, 17)
    text(L + 290, yy + 50, f"{i + 1:02d}", colour, 44, "end", 0)
    split(L + 310, yy + 10, 46, flip=i % 2 == 1, colour=colour)
    box(L + 380, yy + 4, SPLIT_X - L - 450, 58, DIM, 2, v["panel"])
    text(L + 404, yy + 46, state, colour, 32, spacing=4)

# --- lower right: sequence strip and archive block ---
sx, sy = SPLIT_X + 70, MID_Y + 190
months = "DEC NOV OCT SEP AUG JUL JUN MAY APR MAR FEB JAN".split()
pick_m, pick_d = rnd.randrange(12), rnd.randint(1, 31)
plate(sx, sy - 30, 142, 38, "CYCLE 3", 17)
for i, mth in enumerate(months):
    x = sx + 170 + i * 52
    if i == pick_m:
        plate(x - 7, sy - 30, 52, 38, mth, 14)
    else:
        text(x, sy - 5, mth, LINE, 14, spacing=0)
for d in range(1, 32):
    x = sx + 4 + ((d - 1) % 16) * 49
    y = sy + 62 + ((d - 1) // 16) * 44
    if d == pick_d:
        plate(x - 7, y - 26, 46, 36, f"{d:02d}", 18)
    else:
        text(x, y, f"{d:02d}", LINE, 18, spacing=0)
add(f'<path d="M{sx} {sy + 132}H{R - 70}" stroke="{DIM}" stroke-width="2"/>')
box(sx, sy + 160, 270, 150, LINE, 2)
add(f'<path d="M{sx + 84} {sy + 160}V{sy + 310}" stroke="{LINE}" stroke-width="2"/>')
add(f'<rect x="{sx + 18}" y="{sy + 190}" width="48" height="30" fill="{LINE}"/>')
text(sx + 42, sy + 280, "QC", LINE, 20, "middle")
text(sx + 177, sy + 196, "ARCHIVAL", LINE, 17, "middle")
text(sx + 177, sy + 222, "RECORD", LINE, 17, "middle")
add(f'<rect x="{sx + 104}" y="{sy + 240}" width="146" height="32" fill="{LINE}"/>')
small_print(sx + 104, sy + 292, 1, 1, MUTED, 11)
mark(sx + 300, sy + 176, 118)
plate(sx + 430, sy + 176, R - 70 - sx - 430 - 120, 118, NAME, 36, anchor="middle")
checker(R - 70 - 100, sy + 185, 100, 3)

add("</g>")
if v.get("scanlines") == "yes":
    add(f'<rect width="{W}" height="{H}" fill="url(#scan)" opacity="0.22"/>')
add("</svg>")

svg = os.path.join(USER, "wallpaper.svg")
with open(svg, "w") as f:
    f.write("\n".join(out))
try:
    subprocess.run(["rsvg-convert", "-o", png, svg], check=True)
except (OSError, subprocess.CalledProcessError) as e:
    sys.exit(f"hud-wallpaper: could not render: {e}")
with open(stamp_file, "w") as f:
    f.write(stamp)
