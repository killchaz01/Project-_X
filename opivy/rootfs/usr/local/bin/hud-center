#!/usr/bin/env python3
"""hud-center - Application Center and Control Center.

  hud-center apps      open on the installed apps (click one to start it)
  hud-center catalog   open on the catalogue of apps you can install
  hud-center prefs     open on the preferences

Apps are drawn as a grid of numbered keys. Preferences are a front end to hudctl:
every control here runs "hudctl set KEY VALUE".
"""
import json
import os
import shlex
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Pango", "1.0")
gi.require_version("PangoCairo", "1.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango, PangoCairo  # noqa: E402

SYS = "/usr/share/hud"
USER = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "hud")
CATEGORIES = ["all", "internet", "media", "graphics", "office", "develop", "games", "system"]
SHAPES = ["square", "octagon", "round", "cut", "tab", "hex", "slant", "pill", "bracket", "hexagon"]


def settings():
    try:
        with open(os.path.join(USER, "resolved.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


V = settings()


def rgb(key, fallback="#e9f6fa"):
    h = V.get(key, fallback).lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))


def hudctl(*args):
    subprocess.Popen(["hudctl", *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def run(command):
    subprocess.Popen(command, shell=True, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def load_icon(name, size=44):
    theme = Gtk.IconTheme.get_default()
    for candidate in (name, (name or "").lower(), "application-x-executable"):
        if not candidate:
            continue
        try:
            if os.path.isabs(candidate):
                return GdkPixbuf.Pixbuf.new_from_file_at_size(candidate, size, size)
            if theme.has_icon(candidate):
                return theme.load_icon(candidate, size, Gtk.IconLookupFlags.FORCE_SIZE)
        except GLib.Error:
            pass
    return None


class TileGrid(Gtk.DrawingArea):
    """A grid of numbered square keys. Each item is a dict with name, icon, state."""

    TILE_W, TILE_H = 148, 124
    GAP = 14

    def __init__(self, on_activate):
        super().__init__()
        self.items, self.cells, self.hover, self.selected = [], [], -1, -1
        self.on_activate = on_activate
        self.add_events(Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                        Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.connect("draw", self.draw)
        self.connect("motion-notify-event", self.motion)
        self.connect("leave-notify-event", lambda *_: self.set_hover(-1))
        self.connect("button-release-event", self.click)
        self.connect("size-allocate", lambda *_: self.layout())

    def set_items(self, items):
        self.items, self.hover, self.selected = items, -1, -1
        self.layout()
        self.queue_draw()

    def layout(self):
        width = max(self.get_allocated_width(), 300)
        step_x, step_y = self.TILE_W + self.GAP, self.TILE_H + self.GAP
        cols = max(1, int((width - 40 + self.GAP) // step_x))
        self.cells = []
        for i in range(len(self.items)):
            row, col = divmod(i, cols)
            self.cells.append((20 + col * step_x, 16 + row * step_y))
        rows = (len(self.items) + cols - 1) // cols
        self.set_size_request(-1, int(32 + max(0, rows) * step_y))

    def hit(self, x, y):
        for i, (x0, y0) in enumerate(self.cells):
            if x0 <= x <= x0 + self.TILE_W and y0 <= y <= y0 + self.TILE_H:
                return i
        return -1

    def set_hover(self, i):
        if i != self.hover:
            self.hover = i
            self.queue_draw()

    def motion(self, _w, event):
        self.set_hover(self.hit(event.x, event.y))

    def click(self, _w, event):
        i = self.hit(event.x, event.y)
        if i >= 0:
            self.selected = i
            self.queue_draw()
            self.on_activate(self.items[i])

    def draw(self, _w, cr):
        stroke = float(V.get("border_width", 2))
        ground = rgb("panel", "#070b0e")
        w, h = self.TILE_W, self.TILE_H
        for i, item in enumerate(self.items):
            x, y = self.cells[i]
            available = item.get("state") == "available"
            colour = rgb("line_dim") if available else rgb("line")
            ink = rgb("muted") if available else rgb("line")
            lit = i == self.hover or i == self.selected     # a lit key: light plate, dark ink
            if lit:
                colour, ink, ground_now = rgb("line"), rgb("bg", "#030506"), rgb("line")
            else:
                ground_now = ground
            cr.rectangle(x, y, w, h)
            cr.set_source_rgba(*ground_now, 1 if lit else 0.9)
            cr.fill_preserve()
            cr.set_line_join(0)
            cr.set_source_rgba(*colour, 1)
            cr.set_line_width(stroke)
            cr.stroke()

            # Split-square marker and key number, top left. The marker is
            # half lit for an installed app and empty for one on offer.
            m = 14
            cr.set_source_rgba(*ink, 1)
            cr.set_line_width(1.5)
            cr.rectangle(x + 9, y + 9, m, m)
            cr.stroke()
            if not available:
                if i % 2:
                    cr.move_to(x + 9, y + 9), cr.line_to(x + 9 + m, y + 9), cr.line_to(x + 9, y + 9 + m)
                else:
                    cr.move_to(x + 9 + m, y + 9), cr.line_to(x + 9 + m, y + 9 + m), cr.line_to(x + 9, y + 9 + m)
                cr.close_path()
                cr.fill()
            self.text(cr, f"{i + 1:02d}", x + 30, y + 8, ink, 8.5, 40, Pango.Alignment.LEFT)

            icon = item.get("icon")
            if icon:
                Gdk.cairo_set_source_pixbuf(cr, icon, x + (w - icon.get_width()) / 2, y + 30)
                cr.paint()
            else:
                self.text(cr, item["name"][:1].upper(), x + 8, y + 34, ink, 24, w - 16)
            self.text(cr, item["name"].upper(), x + 6, y + h - 28, ink, 7.5, w - 12)

    def text(self, cr, string, x, y, colour, size, width, align=Pango.Alignment.CENTER):
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(Pango.FontDescription(f"{V.get('font_ui', 'Sans')} Bold {size}"))
        layout.set_width(int(width * Pango.SCALE))
        layout.set_alignment(align)
        layout.set_ellipsize(Pango.EllipsizeMode.END)
        layout.set_text(string, -1)
        cr.set_source_rgba(*colour, 1)
        cr.move_to(x, y)
        PangoCairo.show_layout(cr, layout)


def read_catalog():
    entries = []
    for path in (os.path.join(SYS, "catalog.conf"), os.path.join(USER, "catalog.conf")):
        try:
            with open(path) as f:
                for line in f:
                    parts = [p.strip() for p in line.split("|")]
                    if len(parts) == 5 and not line.startswith("#"):
                        entries.append(dict(zip(("name", "package", "category", "icon_name", "about"), parts)))
        except OSError:
            pass
    return entries


def installed_packages(packages):
    if not packages:
        return set()
    out = subprocess.run(["dpkg-query", "-W", "-f=${Package}\t${db:Status-Status}\n", *packages],
                         capture_output=True, text=True).stdout
    return {line.split("\t")[0] for line in out.splitlines() if line.endswith("\tinstalled")}


class Center(Gtk.Window):
    def __init__(self, page):
        super().__init__(title="Application Center")
        self.set_default_size(980, 680)
        self.query, self.category, self.pick = "", "all", None

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(root)

        top = Gtk.Box(spacing=8, margin=12)
        root.pack_start(top, False, False, 0)
        self.tabs = {}
        for key, label in (("apps", "APPS"), ("catalog", "CATALOGUE"), ("prefs", "PREFERENCES")):
            b = Gtk.ToggleButton(label=label)
            b.connect("clicked", self.tab_clicked, key)
            top.pack_start(b, False, False, 0)
            self.tabs[key] = b
        self.search = Gtk.SearchEntry(placeholder_text="Search")
        self.search.connect("search-changed", self.search_changed)
        top.pack_end(self.search, False, False, 0)

        self.stack = Gtk.Stack()
        root.pack_start(self.stack, True, True, 0)

        self.apps_grid = TileGrid(self.launch)
        self.stack.add_named(self.scrolled(self.apps_grid), "apps")
        self.stack.add_named(self.build_catalog(), "catalog")
        self.stack.add_named(self.scrolled(self.build_prefs()), "prefs")

        self.connect("key-press-event", self.key)
        self.connect("destroy", Gtk.main_quit)
        self.show_all()
        self.show_page(page)

    @staticmethod
    def scrolled(child):
        s = Gtk.ScrolledWindow()
        s.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        s.add(child)
        return s

    # ------------------------------------------------------------ pages
    def tab_clicked(self, button, key):
        if button.get_active():
            self.show_page(key)
        elif self.stack.get_visible_child_name() == key:
            button.set_active(True)

    def show_page(self, key):
        self.stack.set_visible_child_name(key)
        for name, b in self.tabs.items():
            b.handler_block_by_func(self.tab_clicked)
            b.set_active(name == key)
            b.handler_unblock_by_func(self.tab_clicked)
        self.set_title("Control Center" if key == "prefs" else "Application Center")
        self.search.set_sensitive(key != "prefs")
        self.refresh()

    def search_changed(self, entry):
        self.query = entry.get_text().strip().lower()
        self.refresh()

    def key(self, _w, event):
        if event.keyval == Gdk.KEY_Escape:
            self.close()

    def refresh(self):
        page = self.stack.get_visible_child_name()
        if page == "apps":
            items = []
            for app in sorted(Gio.AppInfo.get_all(), key=lambda a: a.get_display_name().lower()):
                if not app.should_show():
                    continue
                name = app.get_display_name()
                if self.query and self.query not in name.lower():
                    continue
                icon = app.get_icon()
                items.append({"name": name, "icon": load_icon(icon.to_string() if icon else None),
                              "state": "installed", "app": app})
            self.apps_grid.set_items(items)
        elif page == "catalog":
            catalog = read_catalog()
            have = installed_packages([e["package"] for e in catalog])
            items = []
            for e in catalog:
                if self.category != "all" and e["category"] != self.category:
                    continue
                if self.query and self.query not in (e["name"] + e["about"]).lower():
                    continue
                e["state"] = "installed" if e["package"] in have else "available"
                e["icon"] = load_icon(e["icon_name"]) if e["state"] == "installed" else None
                items.append(e)
            self.catalog_grid.set_items(items)
            self.select(None)

    def launch(self, item):
        item["app"].launch([], None)
        self.close()

    # ---------------------------------------------------------- catalogue
    def build_catalog(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        row = Gtk.Box(spacing=6, margin_start=12, margin_end=12, margin_bottom=6)
        box.pack_start(row, False, False, 0)
        group = None
        for cat in CATEGORIES:
            b = Gtk.RadioButton.new_with_label_from_widget(group, cat.upper())
            b.set_mode(False)
            group = group or b
            b.connect("toggled", self.category_changed, cat)
            row.pack_start(b, False, False, 0)
        self.catalog_grid = TileGrid(self.select)
        box.pack_start(self.scrolled(self.catalog_grid), True, True, 0)

        bar = Gtk.Box(spacing=12, margin=12)
        box.pack_start(bar, False, False, 0)
        self.detail = Gtk.Label(xalign=0)
        self.detail.set_line_wrap(True)
        bar.pack_start(self.detail, True, True, 0)
        self.open_button = Gtk.Button(label="OPEN")
        self.open_button.connect("clicked", lambda _b: run(f"gtk-launch {shlex.quote(self.pick['icon_name'])} "
                                                           f"|| {shlex.quote(self.pick['package'])}"))
        self.action = Gtk.Button(label="INSTALL")
        self.action.get_style_context().add_class("suggested-action")
        self.action.connect("clicked", self.install_or_remove)
        bar.pack_end(self.action, False, False, 0)
        bar.pack_end(self.open_button, False, False, 0)
        return box

    def category_changed(self, button, cat):
        if button.get_active():
            self.category = cat
            self.refresh()

    def select(self, item):
        self.pick = item
        if not item:
            self.detail.set_markup("Pick an app. <b>Bright</b> keys are installed, "
                                   "<b>dim</b> ones can be installed.")
            self.action.hide()
            self.open_button.hide()
            return
        have = item["state"] == "installed"
        self.detail.set_markup(f"<b>{GLib.markup_escape_text(item['name'])}</b>   "
                               f"{GLib.markup_escape_text(item['about'])}\n"
                               f"<small>package: {item['package']}</small>")
        self.action.set_label("REMOVE" if have else "INSTALL")
        self.action.show()
        self.open_button.set_visible(have)

    def install_or_remove(self, _button):
        item = self.pick
        pkg = shlex.quote(item["package"])
        if item["state"] == "installed":
            title, script = f"Removing {item['name']}", f"sudo apt-get remove -y {pkg}"
        else:
            title = f"Installing {item['name']}"
            script = f"sudo apt-get update && sudo apt-get install -y {pkg}"
        script += '; echo; echo "Finished. Press Enter to close."; read _'
        terminal = V.get("terminal", "foot")
        pid = subprocess.Popen([terminal, "-T", title, "-e", "sh", "-c", script]).pid
        GLib.child_watch_add(GLib.PRIORITY_DEFAULT, pid, lambda *_: self.refresh())

    # --------------------------------------------------------- preferences
    def build_prefs(self):
        self.pending = {}
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=16)

        def section(title):
            label = Gtk.Label(xalign=0)
            label.set_markup(f"<b>{title}</b>")
            label.get_style_context().add_class("hud-section")
            box.pack_start(label, False, False, 6)
            flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, column_spacing=14, row_spacing=6,
                               max_children_per_line=4, min_children_per_line=2, homogeneous=True)
            box.pack_start(flow, False, False, 0)
            return flow

        def row(flow, text, widget):
            r = Gtk.Box(spacing=8)
            r.pack_start(Gtk.Label(label=text, xalign=0), True, True, 0)
            r.pack_end(widget, False, False, 0)
            flow.add(r)

        def choice(flow, text, key, options):
            combo = Gtk.ComboBoxText()
            for o in options:
                combo.append_text(o)
            if V.get(key) in options:
                combo.set_active(options.index(V.get(key)))
            combo.connect("changed", lambda c: hudctl("set", key, c.get_active_text()))
            row(flow, text, combo)

        def number(flow, text, key, low, high):
            spin = Gtk.SpinButton.new_with_range(low, high, 1)
            spin.set_value(float(V.get(key, low) or low))
            spin.connect("value-changed", lambda s: self.later(key, str(int(s.get_value()))))
            row(flow, text, spin)

        def toggle(flow, text, key):
            sw = Gtk.Switch(active=V.get(key) == "yes", valign=Gtk.Align.CENTER)
            sw.connect("notify::active", lambda s, _p: hudctl("set", key, "yes" if s.get_active() else "no"))
            row(flow, text, sw)

        def colour(flow, text, key):
            c = Gdk.RGBA()
            c.parse(V.get(key, "#000000"))
            button = Gtk.ColorButton(rgba=c)
            button.connect("color-set", lambda b: hudctl("set", key, "#%02x%02x%02x" % tuple(
                int(round(x * 255)) for x in (b.get_rgba().red, b.get_rgba().green, b.get_rgba().blue))))
            row(flow, text, button)

        def launcher(flow, text, command):
            b = Gtk.Button(label=text)
            b.connect("clicked", lambda _b: run(command))
            flow.add(b)

        term = V.get("terminal", "foot")
        f = section("SYSTEM")
        launcher(f, "NETWORK", f"{term} -e nmtui")
        launcher(f, "SOUND", "pavucontrol")
        launcher(f, "BLUETOOTH", "blueman-manager")
        launcher(f, "DISPLAYS", "wdisplays")
        launcher(f, "UPDATE SYSTEM", f"{term} -e sh -c 'sudo apt-get update && sudo apt-get full-upgrade; "
                                     "echo; echo Finished. Press Enter.; read _'")
        launcher(f, "ABOUT", f"{term} -H hud")

        f = section("THEME")
        themes = subprocess.run(["hudctl", "theme"], capture_output=True, text=True).stdout.split("\n")
        for line in themes:
            name = line[2:].split(" ")[0] if len(line) > 2 else ""
            if name:
                b = Gtk.Button(label=name.upper())
                b.connect("clicked", lambda _b, n=name: hudctl("theme", n))
                f.add(b)

        f = section("SHAPES")
        for key, text in (("shape_menu", "Menu button"), ("shape_hardware", "Hardware read-outs"),
                          ("shape_prefs", "Preference blocks"), ("shape_clock", "Clock"),
                          ("shape_dock", "Dock tiles"), ("shape_button", "Buttons in apps")):
            choice(f, text, key, SHAPES)

        f = section("FRAMES")
        number(f, "Line thickness", "border_width", 1, 5)
        number(f, "Corner size", "radius", 0, 24)
        number(f, "Glow strength", "glow_strength", 0, 3)
        toggle(f, "Glow", "glow")
        toggle(f, "Scan lines", "scanlines")
        toggle(f, "Window halo", "window_shadows")
        number(f, "Text size", "font_size", 7, 18)
        number(f, "Menu bar text size", "bar_font_size", 6, 16)

        f = section("LAYOUT")
        choice(f, "Menu bar", "bar_position", ["top", "bottom"])
        choice(f, "Dock", "dock_position", ["bottom", "left", "right"])
        choice(f, "Window buttons", "window_buttons", ["left", "right"])
        number(f, "Bar height", "bar_height", 28, 56)
        number(f, "Gap around windows", "gap", 0, 30)
        toggle(f, "Natural scrolling", "natural_scroll")
        toggle(f, "Tap to click", "tap_to_click")
        choice(f, "Dock shows", "dock_style", ["labels", "icons"])
        toggle(f, "Numbered dock keys", "dock_numbers")
        choice(f, "Wallpaper", "wallpaper_style", ["console", "calm"])
        toggle(f, "Live console", "console_live")

        f = section("COLOURS")
        for key, text in (("bg", "Background"), ("panel", "Panels"), ("text", "Text"), ("line", "Lines"),
                          ("title", "Titles"), ("cyan", "Read-outs"), ("warn", "Highlights"),
                          ("alert", "Alerts"), ("muted", "Dim text")):
            colour(f, text, key)

        f = section("MODULES")
        out = subprocess.run(["hudctl", "module"], capture_output=True, text=True).stdout
        for line in out.splitlines():
            state, name = line[:3].strip(), line[4:].split(" ")[0]
            if name and name != "windows":
                sw = Gtk.Switch(active=state == "on", valign=Gtk.Align.CENTER)
                sw.connect("notify::active", lambda s, _p, n=name: hudctl(
                    "module", "on" if s.get_active() else "off", n))
                row(f, name.capitalize(), sw)

        note = Gtk.Label(xalign=0, margin_top=10)
        note.set_markup("<small>Changes apply at once. Open windows pick up new colours when "
                        "reopened. Everything here can also be set with <tt>hudctl</tt>.</small>")
        box.pack_start(note, False, False, 0)
        return box

    def later(self, key, value):
        """Wait until a number stops changing before applying it."""
        if key in self.pending:
            GLib.source_remove(self.pending[key])

        def fire():
            del self.pending[key]
            hudctl("set", key, value)
            return False
        self.pending[key] = GLib.timeout_add(500, fire)


def main():
    page = sys.argv[1] if len(sys.argv) > 1 else "apps"
    if page not in ("apps", "catalog", "prefs"):
        print(__doc__.strip())
        sys.exit(1)
    css = Gtk.CssProvider()
    css.load_from_data(b".hud-section { letter-spacing: 3px; margin-top: 10px; }")
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    Center(page)
    Gtk.main()


if __name__ == "__main__":
    main()
