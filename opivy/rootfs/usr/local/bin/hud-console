#!/usr/bin/env python3
"""hud-console - the live station console on the desktop.

Draws the console (status board, station log, status frame, function
list) on the desktop layer under all windows, with real data, redrawn
every second. Click a panel to use it: the status rows open processes,
files, network settings and the power menu; the frame runs the system
scan; the function list and keys do what they say. Right-click opens
the system menu.

Runs when wallpaper_style is "console" and console_live is "yes";
otherwise it exits and the still wallpaper is shown instead.
"""
import json
import os
import subprocess
import sys

sys.path.insert(0, "/usr/share/hud/lib")
import console_layout  # noqa: E402

import gi  # noqa: E402
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
gi.require_version("Rsvg", "2.0")
from gi.repository import Gdk, GLib, Gtk, GtkLayerShell, Rsvg  # noqa: E402

USER = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "hud")


def settings():
    try:
        with open(os.path.join(USER, "resolved.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


class Console(Gtk.Window):
    def __init__(self, v):
        super().__init__()
        self.v = v
        self.probe = console_layout.Probe()
        self.handle, self.spots, self.hover = None, [], None
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.BOTTOM)
        GtkLayerShell.set_namespace(self, "hud-console")
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                     GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self, edge, True)
        GtkLayerShell.set_exclusive_zone(self, -1)     # cover the whole screen, under the bars
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)

        self.area = Gtk.DrawingArea()
        self.area.add_events(Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.BUTTON_PRESS_MASK |
                        Gdk.EventMask.BUTTON_RELEASE_MASK |
                             Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.area.connect("draw", self.draw)
        self.area.connect("motion-notify-event", self.motion)
        self.area.connect("leave-notify-event", lambda *_: self.set_hover(None))
        self.area.connect("button-release-event", self.click)
        self.area.set_has_tooltip(True)
        self.area.connect("query-tooltip", self.tooltip)
        self.add(self.area)
        self.refresh()
        GLib.timeout_add_seconds(1, self.refresh)
        self.show_all()

    # The drawing is 2560x1600; it is scaled to cover the screen, centred.
    def geometry(self):
        w, h = self.area.get_allocated_width(), self.area.get_allocated_height()
        s = max(w / console_layout.W, h / console_layout.H) or 1
        return s, (w - console_layout.W * s) / 2, (h - console_layout.H * s) / 2

    def refresh(self):
        data = self.probe.collect(self.v)
        svg, self.spots = console_layout.build(self.v, data, glow=self.v.get("console_glow") == "yes")
        try:
            self.handle = Rsvg.Handle.new_from_data(svg.encode())
        except GLib.Error as e:
            print("hud-console:", e, file=sys.stderr)
        self.area.queue_draw()
        return True

    def draw(self, _w, cr):
        if not self.handle:
            return
        s, ox, oy = self.geometry()
        cr.save()
        cr.translate(ox, oy)
        cr.scale(s, s)
        rect = Rsvg.Rectangle()
        rect.x, rect.y, rect.width, rect.height = 0, 0, console_layout.W, console_layout.H
        self.handle.render_document(cr, rect)
        if self.hover is not None and self.hover < len(self.spots):
            x, y, w, h, _cmd, _tip = self.spots[self.hover]
            col = Gdk.RGBA()
            col.parse(self.v.get("cyan", "#9fe6f5"))
            cr.set_source_rgba(col.red, col.green, col.blue, 0.9)
            cr.set_line_width(3)
            cr.rectangle(x - 6, y - 6, w + 12, h + 12)
            cr.stroke()
        cr.restore()

    def spot_at(self, ex, ey):
        s, ox, oy = self.geometry()
        x, y = (ex - ox) / s, (ey - oy) / s
        found = None
        for i, (sx, sy, sw, sh, _c, _t) in enumerate(self.spots):
            if sx <= x <= sx + sw and sy <= y <= sy + sh:
                found = i        # later (smaller, more specific) spots win
        return found

    def set_hover(self, i):
        if i != self.hover:
            self.hover = i
            window = self.area.get_window()
            if window:
                cursor = Gdk.Cursor.new_from_name(window.get_display(), "pointer" if i is not None else "default")
                window.set_cursor(cursor)
            self.area.queue_draw()

    def motion(self, _w, event):
        self.set_hover(self.spot_at(event.x, event.y))

    def tooltip(self, _w, x, y, _kb, tip):
        i = self.spot_at(x, y)
        if i is None:
            return False
        tip.set_text(self.spots[i][5])
        return True

    def click(self, _w, event):
        if event.button == 3:
            run("hud-menu")
            return
        if event.button != 1:
            return
        i = self.spot_at(event.x, event.y)
        if i is not None:
            run(self.spots[i][4])


def run(command):
    subprocess.Popen(command, shell=True, start_new_session=True, cwd=os.path.expanduser("~"),
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return
    v = settings()
    if not v:
        sys.exit("hud-console: no settings yet (run: hudctl apply)")
    if v.get("wallpaper_style", "console") != "console" or v.get("console_live", "yes") != "yes":
        return
    if not GtkLayerShell.is_supported():
        sys.exit("hud-console: this desktop does not support layer-shell")
    Console(v).connect("destroy", Gtk.main_quit)
    Gtk.main()


if __name__ == "__main__":
    main()
