#!/usr/bin/env python3
"""hud-search - find and open apps and files, like Spotlight (Cmd+Space).

Type part of a name. Apps come first, then files and folders in your home
folder. Return opens the pick. If nothing matches, Return opens what you
typed as a web address, or searches the web for it.
"""
import json
import os
import shlex
import subprocess
import sys
import urllib.parse

sys.path.insert(0, "/usr/share/hud/lib")
import hudapps  # noqa: E402

HOME = hudapps.HOME
SKIP = {"node_modules", "__pycache__", "Applications", "snap", "venv", "target", "build"}
MAX_FILES, MAX_DEPTH = 20000, 6


def settings():
    try:
        with open(os.path.join(hudapps.USER, "resolved.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def run(command):
    subprocess.Popen(command, shell=True, start_new_session=True, cwd=HOME,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def files():
    count = 0
    for folder, dirs, names in os.walk(HOME):
        depth = folder[len(HOME):].count(os.sep)
        dirs[:] = sorted(d for d in dirs if not d.startswith(".") and d not in SKIP) if depth < MAX_DEPTH else []
        rel = os.path.relpath(folder, HOME)
        where = "~" if rel == "." else "~/" + rel
        for name in dirs + sorted(n for n in names if not n.startswith(".")):
            yield name, where, os.path.join(folder, name)
            count += 1
            if count >= MAX_FILES:
                return


def main():
    v = settings()
    term = v.get("terminal", "foot")
    lines, actions = [], {}
    apps = hudapps.desktop_entries()
    seen = set()
    for app in sorted(apps, key=lambda a: hudapps.app_name(a["id"], apps).lower()):
        if app["hidden"] or not app["exec"] or hudapps.is_helper(app):
            continue
        label = hudapps.app_name(app["id"], apps)
        if label in seen:
            continue
        seen.add(label)
        command = " ".join(w for w in app["exec"].split() if not w.startswith("%"))
        actions[label] = f"{term} -e {command}" if app.get("terminal") else command
        lines.append(f"{label}\0icon\x1f{app['icon']}")
    for name, where, path in files():
        label = f"{name}    {where}"
        if label in actions:
            continue
        actions[label] = "xdg-open " + shlex.quote(path)
        icon = "folder" if os.path.isdir(path) else "text-x-generic"
        lines.append(f"{label}\0icon\x1f{icon}")
    try:
        out = subprocess.run(["fuzzel", "--dmenu", "--prompt", "SEARCH > ", "--lines", "12", "--width", "60"],
                             input="\n".join(lines), capture_output=True, text=True)
    except OSError as e:
        sys.exit(f"hud-search: {e}")
    pick = out.stdout.strip("\n")
    if not pick:
        return
    if pick in actions:
        run(actions[pick])
    elif " " not in pick and "." in pick:
        run("xdg-open " + shlex.quote(pick if "://" in pick else "https://" + pick))
    else:
        run("xdg-open " + shlex.quote("https://duckduckgo.com/?q=" + urllib.parse.quote(pick)))


if __name__ == "__main__":
    main()
