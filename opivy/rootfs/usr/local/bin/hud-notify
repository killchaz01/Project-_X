#!/usr/bin/env python3
"""hud-notify - the notification centre (click the clock).

A panel at the top right listing recent notifications, newest first,
with a Do Not Disturb switch and Clear. Click the clock again, press
Escape or click CLOSE to put it away.
"""
import json
import os
import signal
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GLib, Gtk, GtkLayerShell  # noqa: E402

CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "hud")
PIDFILE = os.path.join(CACHE, "notify.pid")
CLEARED = os.path.join(CACHE, "notify.cleared")


def makoctl(*args):
    try:
        return subprocess.run(["makoctl", *args], capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def plain(value):
    """mako wraps each value as {"type": .., "data": ..}; unwrap it."""
    return value.get("data") if isinstance(value, dict) and "data" in value else value


def history():
    """Past notifications as [{id, app, summary, body}], newest first."""
    out = makoctl("history", "-j") or makoctl("history")
    items = []
    try:
        data = json.loads(out)
        rows = plain(data)
        if rows and isinstance(rows[0], list):
            rows = rows[0]
        for r in rows:
            items.append({"id": int(plain(r.get("id", 0)) or 0), "app": plain(r.get("app-name", r.get("app_name", ""))) or "",
                          "summary": plain(r.get("summary", "")) or "", "body": plain(r.get("body", "")) or ""})
    except (ValueError, TypeError, AttributeError, IndexError):
        cur = None            # text form: "Notification 3: Summary" then indented fields
        for line in out.splitlines():
            if line.startswith("Notification "):
                head, _, summary = line.partition(": ")
                cur = {"id": int("".join(c for c in head if c.isdigit()) or 0), "app": "", "summary": summary, "body": ""}
                items.append(cur)
            elif cur and line.strip().startswith("App name:"):
                cur["app"] = line.split(":", 1)[1].strip()
            elif cur and line.strip().startswith("Body:"):
                cur["body"] = line.split(":", 1)[1].strip()
    return sorted(items, key=lambda i: -i["id"])


def cleared_up_to():
    try:
        return int(open(CLEARED).read().strip() or 0)
    except (OSError, ValueError):
        return 0


class Panel(Gtk.Window):
    def __init__(self):
        super().__init__()
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_namespace(self, "hud-notify")
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self, edge, True)
            GtkLayerShell.set_margin(self, edge, 8)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)
        self.set_size_request(400, -1)
        self.get_style_context().add_class("hud-notify")

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=14)
        self.add(box)
        head = Gtk.Box(spacing=8)
        title = Gtk.Label(xalign=0)
        title.set_markup("<b>NOTIFICATIONS</b>")
        title.get_style_context().add_class("hud-section")
        head.pack_start(title, True, True, 0)
        close = Gtk.Button(label="CLOSE")
        close.connect("clicked", lambda _b: self.close())
        head.pack_end(close, False, False, 0)
        box.pack_start(head, False, False, 0)

        row = Gtk.Box(spacing=8)
        row.pack_start(Gtk.Label(label="Do Not Disturb", xalign=0), True, True, 0)
        self.dnd = Gtk.Switch(active="do-not-disturb" in makoctl("mode"), valign=Gtk.Align.CENTER)
        self.dnd.connect("notify::active", self.toggle_dnd)
        row.pack_end(self.dnd, False, False, 0)
        box.pack_start(row, False, False, 0)
        box.pack_start(Gtk.Separator(), False, False, 0)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_min_content_height(260)
        scroll.set_max_content_height(520)
        scroll.set_propagate_natural_height(True)
        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        scroll.add(self.list)
        box.pack_start(scroll, True, True, 0)

        clear = Gtk.Button(label="CLEAR ALL")
        clear.connect("clicked", self.clear)
        box.pack_start(clear, False, False, 0)

        self.connect("key-press-event", lambda _w, e: self.close() if e.keyval == Gdk.KEY_Escape else None)
        self.connect("destroy", Gtk.main_quit)
        self.fill()
        GLib.timeout_add_seconds(3, self.fill)
        self.show_all()

    def fill(self):
        for child in self.list.get_children():
            self.list.remove(child)
        floor = cleared_up_to()
        items = [i for i in history() if i["id"] > floor][:30]
        self.newest = max([i["id"] for i in history()] + [floor])
        if not items:
            empty = Gtk.Label(label="No notifications", xalign=0)
            empty.set_sensitive(False)
            self.list.pack_start(empty, False, False, 6)
        for i in items:
            text = f"<b>{GLib.markup_escape_text(i['summary'])}</b>"
            if i["app"]:
                text = f"<small>{GLib.markup_escape_text(i['app'].upper())}</small>\n" + text
            if i["body"]:
                text += "\n" + GLib.markup_escape_text(i["body"])
            label = Gtk.Label(xalign=0)
            label.set_markup(text)
            label.set_line_wrap(True)
            label.set_max_width_chars(44)
            self.list.pack_start(label, False, False, 0)
            self.list.pack_start(Gtk.Separator(), False, False, 0)
        self.list.show_all()
        return True

    def toggle_dnd(self, switch, _p):
        on = "do-not-disturb" in makoctl("mode")
        if switch.get_active() != on:
            makoctl("mode", "-t", "do-not-disturb")
            subprocess.run(["pkill", "-RTMIN+8", "waybar"])

    def clear(self, _b):
        makoctl("dismiss", "-a")
        with open(CLEARED, "w") as f:
            f.write(str(self.newest))
        self.fill()


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return
    os.makedirs(CACHE, exist_ok=True)
    try:                                   # already open: this click closes it
        pid = int(open(PIDFILE).read())
        if "hud-notify" in open(f"/proc/{pid}/cmdline").read():
            os.kill(pid, signal.SIGTERM)
            os.remove(PIDFILE)
            return
    except (OSError, ValueError):
        pass
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))
    css = Gtk.CssProvider()
    css.load_from_data(b".hud-section { letter-spacing: 3px; } "
                       b"window.hud-notify { border: 2px solid @accent_bg_color; }")
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    signal.signal(signal.SIGTERM, lambda *_: Gtk.main_quit())
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, Gtk.main_quit)
    Panel()
    Gtk.main()
    try:
        os.remove(PIDFILE)
    except OSError:
        pass


if __name__ == "__main__":
    main()
