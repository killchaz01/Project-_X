# Written by hudctl from the active theme.
border.width: 1
titlebar.height: 28
window.titlebar.padding.width: 8
window.button.width: 22
window.button.spacing: 2
window.label.text.justify: center

window.active.border.color: {{line}}
window.inactive.border.color: {{line_dim}}
window.active.title.bg.color: {{panel}}
window.inactive.title.bg.color: {{bg}}
window.active.label.text.color: {{title}}
window.inactive.label.text.color: {{muted}}

window.active.button.unpressed.image.color: {{line}}
window.inactive.button.unpressed.image.color: {{muted}}
window.active.button.close.unpressed.image.color: {{alert}}
window.active.button.iconify.unpressed.image.color: {{warn}}
window.active.button.max.unpressed.image.color: {{ok}}

window.active.shadow.size: 40
window.inactive.shadow.size: 24
window.active.shadow.color: #00000080
window.inactive.shadow.color: #00000050

menu.border.width: 1
menu.border.color: {{line}}
menu.items.bg.color: {{panel}}
menu.items.text.color: {{text}}
menu.items.active.bg.color: {{line}}
menu.items.active.text.color: {{bg}}
menu.separator.color: {{line_dim}}
menu.title.bg.color: {{panel}}
menu.title.text.color: {{title}}

osd.bg.color: {{panel}}
osd.border.color: {{line}}
osd.border.width: 1
osd.label.text.color: {{text}}
osd.window-switcher.style-classic.item.active.border.color: {{title}}
osd.window-switcher.preview.border.color: {{title}}
snapping.overlay.region.bg.color: {{line}}
snapping.overlay.edge.bg.color: {{line}}
