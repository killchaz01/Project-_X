#!/usr/bin/env python3
"""hud-wallpaper - draw the desktop background from the active theme.

Reads ~/.config/hud/resolved.json (written by hudctl apply) and writes
wallpaper.svg and wallpaper.png next to it. The picture is an orbital
plot: star field, trajectory lines, a wireframe globe and framed labels.
Change "wallpaper_seed" for a different arrangement.
"""
import hashlib
import json
import math
import os
import random
import subprocess
import sys

USER = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "hud")
W, H = 2560, 1600

with open(os.path.join(USER, "resolved.json")) as f:
    v = json.load(f)
if v.get("wallpaper", "generated") != "generated":
    sys.exit(0)

keys = ("bg bg_alt panel text muted line line_dim title warn alert ok cool cyan "
        "wallpaper_seed scanlines glow os_name font_ui font_mono border_width radius glow_strength").split()
stamp = hashlib.sha256(json.dumps([v.get(k) for k in keys] + [7]).encode()).hexdigest()
stamp_file = os.path.join(USER, "wallpaper.stamp")
png = os.path.join(USER, "wallpaper.png")
if os.path.exists(png) and os.path.exists(stamp_file) and open(stamp_file).read() == stamp:
    sys.exit(0)

SW = float(v.get("border_width", "2"))
RX = float(v.get("radius", "10")) * 2.4
rnd = random.Random(int(v.get("wallpaper_seed", "7") or 7))
glow = ' filter="url(#glow)"' if v.get("glow") == "yes" else ""
out = []
add = out.append

add(f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" viewBox="0 0 {W} {H}">')
add(f'''<defs>
<radialGradient id="space" cx="50%" cy="48%" r="70%">
 <stop offset="0" stop-color="{v["bg_alt"]}"/><stop offset="1" stop-color="{v["bg"]}"/>
</radialGradient>
<filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
 <feGaussianBlur stdDeviation="{3 + 2 * int(v.get("glow_strength", "2") or 0)}" result="b"/>
 <feMerge><feMergeNode in="b"/><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
</filter>
<pattern id="scan" width="4" height="4" patternUnits="userSpaceOnUse">
 <rect width="4" height="1.3" fill="{v["bg"]}"/>
</pattern>
<pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse">
 <rect width="6" height="3" fill="{v["warn"]}"/>
</pattern>
</defs>''')
add(f'<rect width="{W}" height="{H}" fill="url(#space)"/>')

# Star field.
for _ in range(520):
    x, y = rnd.uniform(0, W), rnd.uniform(0, H)
    colour = rnd.choice([v["muted"], v["muted"], v["text"], v["cool"], v["cyan"]])
    add(f'<circle cx="{x:.0f}" cy="{y:.0f}" r="{rnd.choice([1, 1, 1.5, 2, 2.6])}" '
        f'fill="{colour}" opacity="{rnd.uniform(0.3, 0.9):.2f}"/>')

cx, cy = W * 0.5, H * 0.5


def label(x, y, text, colour, size=26, anchor="start", family=None):
    family = family or v["font_ui"]
    add(f'<text x="{x:.0f}" y="{y:.0f}" fill="{colour}" font-family="{family}, sans-serif" '
        f'font-size="{size}" font-weight="bold" letter-spacing="3" text-anchor="{anchor}"{glow}>{text}</text>')


def tag(x, y, text, colour):
    """A rounded outlined label box, top-left at x,y."""
    width = 34 + len(text) * 19
    add(f'<path d="M{x + 14} {y}H{x + width}V{y + 32}L{x + width - 14} {y + 46}H{x}V{y + 14}Z" '
        f'fill="{v["bg"]}" fill-opacity="0.6" stroke="{colour}" stroke-width="{SW + 1}" '
        f'stroke-linejoin="round"{glow}/>')
    label(x + 18, y + 33, text, colour, 28)


# Outer frame with corner ticks.
m = 46
add(f'<rect x="{m}" y="{m}" width="{W - 2 * m}" height="{H - 2 * m}" rx="{RX}" fill="none" '
    f'stroke="{v["line"]}" stroke-width="{SW + 1}" opacity="0.8"{glow}/>')
for x, y in ((m, m), (W - m, m), (m, H - m), (W - m, H - m)):
    add(f'<path d="M{x - 14} {y}H{x + 14}M{x} {y - 14}V{y + 14}" stroke="{v["alert"]}" stroke-width="3"/>')

# Reference orbits around the centre.
for rx, ry, colour, op in ((300, 96, v["muted"], 0.7), (720, 250, v["line_dim"], 0.8),
                           (1180, 430, v["line_dim"], 0.5)):
    add(f'<ellipse cx="{cx}" cy="{cy}" rx="{rx}" ry="{ry}" fill="none" stroke="{colour}" '
        f'stroke-width="1.5" opacity="{op}"/>')

# Trajectory lines: long straight tracks crossing the plot.
tracks = []
for i in range(15):
    side = rnd.random()
    if side < 0.5:      # left edge to right edge
        a = (m, rnd.uniform(m, H - m))
        b = (W - m, rnd.uniform(m, H - m))
    else:               # top edge to bottom edge
        a = (rnd.uniform(m, W - m), m)
        b = (rnd.uniform(m, W - m), H - m)
    colour = [v["alert"], v["alert"], v["line"], v["warn"]][i % 4]
    width = rnd.choice([1.5, 2, 2, 3])
    tracks.append((a, b, colour))
    add(f'<line x1="{a[0]:.0f}" y1="{a[1]:.0f}" x2="{b[0]:.0f}" y2="{b[1]:.0f}" stroke="{colour}" '
        f'stroke-width="{width}" opacity="0.85"{glow}/>')

# Tracked objects: diamonds placed along some of the tracks.
names = ["KD1", "MH", "PX4", "TR", "VA2", "LN", "QB7", "ES"]
for i, (a, b, colour) in enumerate(tracks[:8]):
    t = rnd.uniform(0.15, 0.85)
    x, y = a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t
    if abs(x - cx) < 330 and abs(y - cy) < 330:
        continue
    s = rnd.choice([13, 16, 20])
    add(f'<path d="M{x:.0f} {y - s:.0f}L{x + s:.0f} {y:.0f}L{x:.0f} {y + s:.0f}L{x - s:.0f} {y:.0f}Z" '
        f'fill="{colour}"{glow}/>')
    label(x + s + 12, y + 9, f"OBJ {2031 + i % 3} {names[i]}", colour, 24)

# Wireframe globe with a cloud of satellites.
R = 250
add(f'<circle cx="{cx}" cy="{cy}" r="{R}" fill="{v["bg"]}" fill-opacity="0.85" stroke="{v["line"]}" '
    f'stroke-width="3"{glow}/>')
for k in (0.25, 0.55, 0.85):
    add(f'<ellipse cx="{cx}" cy="{cy}" rx="{R * k:.0f}" ry="{R}" fill="none" stroke="{v["line"]}" '
        f'stroke-width="1.5" opacity="0.6"/>')
for lat in (-60, -30, 0, 30, 60):
    yy = cy + R * math.sin(math.radians(lat))
    rr = R * math.cos(math.radians(lat))
    add(f'<ellipse cx="{cx}" cy="{yy:.0f}" rx="{rr:.0f}" ry="{rr * 0.16:.0f}" fill="none" '
        f'stroke="{v["line"]}" stroke-width="1.5" opacity="{0.9 if lat == 0 else 0.5}"/>')
for _ in range(620):
    ang = rnd.uniform(0, 2 * math.pi)
    dist = R * rnd.choice([rnd.uniform(0.2, 1.0), rnd.uniform(1.0, 1.16), rnd.uniform(1.0, 1.1)])
    x, y = cx + dist * math.cos(ang), cy + dist * math.sin(ang)
    colour = rnd.choice([v["cyan"], v["cyan"], v["ok"], v["cool"]])
    add(f'<rect x="{x:.0f}" y="{y:.0f}" width="4" height="4" fill="{colour}" opacity="{rnd.uniform(0.5, 1):.2f}"/>')
# Sun-side marker.
add(f'<path d="M{cx + R + 14} {cy - 70}L{cx + R + 120} {cy}L{cx + R + 14} {cy + 70}Z" fill="url(#hatch)" opacity="0.9"/>')
label(cx, cy + R + 52, "PRIMARY", v["title"], 26, "middle")
label(cx + 330, cy - 104, "PERIAPSIS", v["muted"], 22)
label(cx - 330, cy + 122, "APOAPSIS", v["muted"], 22, "end")

# Corner panel: small system map.
px, py = m + 60, H - m - 330
tag(px, py, "SYSTEM MAP", v["alert"])
sx, sy = px + 230, py + 200
add(f'<circle cx="{sx}" cy="{sy}" r="12" fill="{v["warn"]}"{glow}/>')
for i, rx in enumerate((50, 90, 135, 185, 240)):
    add(f'<ellipse cx="{sx}" cy="{sy}" rx="{rx}" ry="{rx * 0.42:.0f}" fill="none" stroke="{v["line_dim"]}" stroke-width="1.5"/>')
    ang = rnd.uniform(0, 2 * math.pi)
    add(f'<circle cx="{sx + rx * math.cos(ang):.0f}" cy="{sy + rx * 0.42 * math.sin(ang):.0f}" r="5" '
        f'fill="{[v["cyan"], v["cool"], v["ok"], v["alert"], v["text"]][i]}"/>')

tag(m + 60, m + 50, "ORBIT PLOT", v["alert"])

# Title block, top right: tall compressed serif capitals.
name = v.get("os_name", "HUD").upper()
tx, ty = W - m - 70, m + 150
add(f'<g{glow}><text transform="translate({tx} {ty}) scale(0.62 1.3)" x="0" y="0" text-anchor="end" '
    f'font-family="DejaVu Serif, Noto Serif, serif" font-weight="bold" font-size="120" '
    f'fill="{v["title"]}">{name}</text></g>')
label(tx, ty + 50, "ORBITAL DESKTOP SYSTEM", v["muted"], 26, "end")
label(tx, ty + 90, "LINK NOMINAL", v["line"], 26, "end")

# Read-out column, bottom right.
rx0, ry0 = W - m - 70, H - m - 250
tag(rx0 - 220, ry0 - 70, "DATA FEED", v["alert"])
for i in range(6):
    row = f"{291 + i:03d}  TRACK-{rnd.randint(10, 99)}  {rnd.choice(['STL', 'NOM', 'NOM', 'DRF'])}  {rnd.randint(400, 620)}"
    label(rx0, ry0 + 20 + i * 34, row, v["title"], 24, "end", v["font_mono"])

if v.get("scanlines") == "yes":
    add(f'<rect width="{W}" height="{H}" fill="url(#scan)" opacity="0.28"/>')
add("</svg>")

svg = os.path.join(USER, "wallpaper.svg")
with open(svg, "w") as f:
    f.write("\n".join(out))
try:
    subprocess.run(["rsvg-convert", "-o", png, svg], check=True)
except (OSError, subprocess.CalledProcessError) as e:
    sys.exit(f"hud-wallpaper: could not render: {e}")
with open(stamp_file, "w") as f:
    f.write(stamp)
